# Media directory: static content only. Never execute anything here, even if a
# malicious upload slipped past the CMS's extension + MIME checks.
Options -Indexes -ExecCGI

# Deny web access to any script-like file outright (Apache 2.4 / LiteSpeed).
<FilesMatch "\.(php|phar|phtml|pht|php[0-9]|cgi|pl|py|sh|asp|aspx|jsp)$">
  Require all denied
</FilesMatch>

# Belt and braces: strip any handler/type that would run PHP.
<IfModule mod_mime.c>
  RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
  RemoveType .php .phtml .phar
</IfModule>

# Don't hand back the raw config if it were ever placed in the web root.
<FilesMatch "^(config|eca-cms-config)\.php$">
  Require all denied
</FilesMatch>
